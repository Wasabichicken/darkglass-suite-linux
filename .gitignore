# Cached downloads - the Darkglass installer itself and third-party
# tooling under cache/tools/ (appimagetool, type2-runtime), both
# regenerable by build.sh (which downloads them if missing).
/cache/

# Build artifacts
*.AppImage

# mirror/mirror.sh's archive of historical Darkglass installers.
/mirror/archive/
/mirror/*.log
/mirror/*.lock
